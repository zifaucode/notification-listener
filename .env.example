PORT=5000

# Secret key untuk menandatangani JWT token (otomatis digenerate jika kosong/default)
JWT_SECRET=ganti-dengan-secret-key-yang-kuat

# Path ke database SQLite
DB_PATH=data.db

# Masa berlaku token JWT (dalam hari)
JWT_EXPIRY_DAYS=7

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
